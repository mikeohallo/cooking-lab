build/
.gradle/

# --- Local environment / secrets --------------------------------------------
.env
.env.*
!.env.example
*.local
secrets.json
google-services.json
GoogleService-Info.plist

# --- Tooling caches ----------------------------------------------------------
coverage/
.eslintcache
*.tsbuildinfo

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# --- Build Control runner (local only) --------------------------------------
# Runner locks, child process records, consumed-instruction state and logs.
# Never committed; never holds credentials or tokens.
.build-control-local/
